{
    "name": "@openhps/openvslam",
    "version": "0.1.0-alpha.0",
    "description": "Open Hybrid Positioning System - OpenVSLAM bindings",
    "author": "Maxim Van de Wynckel",
    "license": "Apache-2.0",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/OpenHPS/openhps-openvslam.git"
    },
    "bugs": {
        "url": "https://github.com/OpenHPS/openhps-openvslam/issues"
    },
    "homepage": "https://openhps.org",
    "publishConfig": {
        "access": "public"
    },
    "type": "commonjs",
    "sideEffects": false,
    "main": "./dist/cjs/index.js",
    "types": "./dist/types/index.d.ts",
    "module": "./dist/esm/index.js",
    "es2015": "./dist/esm/index.js",
    "exports": {
        ".": {
            "types": "./dist/types/index.d.ts",
            "import": "./dist/esm/index.js",
            "require": "./dist/cjs/index.js"
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist/**/*",
        "src/**/*",
        "build/**/*",
        "cc/**/*",
        "install/**/*",
        "LICENSE"
    ],
    "scripts": {
        "install": "node ./install/install.js",
        "test": "mocha --config test/.mocharc.json",
        "test:docker": "docker-compose run openvslam-cpu /opt/app/docker/docker-entrypoint.sh",
        "test:docker:quick": "docker-compose run openvslam-cpu /opt/app/docker/docker-entrypoint-quick.sh",
        "cover": "c8 mocha --config test/.mocharc.json",
        "cover:ci": "c8 mocha --config test/.mocharc.ci.json && c8 report --reporter=cobertura",
        "lint": "eslint . && node scripts/check-peers.mjs",
        "clean": "shx rm -rf ./dist && shx rm -rf ./docs/out",
        "build": "npm run clean && npm-run-all --parallel build:ts:*",
        "build:components": "componentsjs-generator",
        "build:quick": "npm-run-all --parallel build:ts:*",
        "build:typedoc": "typedoc --options docs/typedoc.json",
        "build:ts:cjs": "tsc --build ./tsconfig/tsconfig.bundle.cjs.json",
        "build:ts:esm": "tsc --build ./tsconfig/tsconfig.bundle.esm.json && node ./scripts/finalize-esm.mjs",
        "build:ts:types": "tsc --build ./tsconfig/tsconfig.bundle.types.json",
        "deploy:typedoc": "gh-pages -d ./docs/out",
        "bump:development": "commit-and-tag-version --prerelease alpha -m 'chore(alpha): %s' --skip.changelog",
        "bump:beta": "commit-and-tag-version --prerelease beta -m 'chore(beta): %s' --skip.changelog",
        "bump:release": "commit-and-tag-version -m 'chore(release): %s' --skip.changelog",
        "prepare": "husky"
    },
    "keywords": [
        "openhps",
        "openvslam"
    ],
    "dependencies": {
        "@openhps/opencv": "^0.3.6",
        "nan": "^2.15.0",
        "native-node-utils": "^0.2.7",
        "node-addon-api": "^5.0.0",
        "npmlog": "^6.0.2",
        "tslib": "^2.8.1"
    },
    "peerDependencies": {
        "@openhps/core": ">=1.0.16 <2",
        "@openhps/opencv": ">=0.3.6 <0.4",
        "reflect-metadata": ">=0.2.2 <1"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@eslint/js": "^9.34.0",
        "@openhps/core": "^1.0.16",
        "@openhps/opencv": "^0.3.6",
        "@openhps/video": "^1.0.3",
        "@types/chai": "^5.2.2",
        "@types/mocha": "^10.0.10",
        "@types/node": "^24.3.0",
        "c8": "^12.0.0",
        "chai": "^6.2.2",
        "commit-and-tag-version": "^13.1.2",
        "eslint": "^9.34.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-jsdoc": "^54.1.1",
        "eslint-plugin-prettier": "^5.5.4",
        "globals": "^16.3.0",
        "husky": "^9.1.7",
        "jenkins-mocha": "^9.0.0",
        "lint-staged": "^17.3.0",
        "mocha": "^11.8.0",
        "mocha-junit-reporter": "^2.2.1",
        "mocha-multi-reporters": "^1.5.1",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.9.6",
        "reflect-metadata": ">=0.1.13",
        "segfault-handler": "^1.3.0",
        "shx": "^0.4.0",
        "ts-node": "^10.9.2",
        "typedoc": "^0.28.20",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.66.0"
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "packageManager": "npm@10.9.2",
    "lsd:module": true,
    "gypfile": true,
    "husky": {
        "hooks": {
            "pre-commit": "npm run lint",
            "pre-push": "npm run test",
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
